# Segredos do orchestrator. COPIA para .env e preenche.
#
# O .env está no .gitignore e nunca deve ser committed, enviado por chat,
# nem incluído num zip. Se uma chave alguma vez passar por um desses
# sítios, roda-a no painel do fornecedor — é mais rápido do que avaliar
# se houve estrago.

# ---- Stripe (stack nextjs-pagamentos) ----
# Só chaves de TESTE enquanto o servidor não tiver autenticação.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLIC_KEY=pk_test_...

# ---- Sanity (stack nextjs-sanity) ----
# Token PESSOAL com papel Administrator ou Developer: é o que permite
# criar projetos automaticamente. Obtém-se com `npx sanity login`.
# Atenção: desde junho de 2026 os tokens do Sanity podem ter validade.
SANITY_AUTH_TOKEN=
SANITY_DATASET=production

# Origens autorizadas no CORS do Sanity, separadas por vírgula.
# Sem a origem certa, o Studio abre e fica preso no ecrã de login.
SANITY_CORS_ORIGINS=http://SEU_IP:3000
PUBLIC_ORIGIN=http://SEU_IP:3000

# ---- Acesso ao painel ----
# Sem OFFICE_PASSWORD o orchestrator fica ABERTO a quem souber o IP.
OFFICE_USER=fabio
OFFICE_PASSWORD=
# Segredo das assinaturas de sessão. Sem isto gera-se um novo a cada
# reinício e as sessões abertas caem — funciona, mas obriga a repetir
# a password depois de cada pm2 restart.
OFFICE_SECRET=

# Origens autorizadas em CORS. Vazio = nenhuma (o painel não precisa).
OFFICE_CORS_ORIGINS=

# ---- GitHub (publicar plataformas do vault) ----
# Token em github.com/settings/personal-access-tokens/new
# Permissões: Contents = Read and write, Administration = Read and write
GITHUB_TOKEN=github_pat_...
